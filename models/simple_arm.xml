<mujoco model="MyRobotArm">

    <default>
        <geom contype="0" conaffinity="0"/>
    </default>

    <compiler angle="radian"/>

    <option timestep="0.002" gravity="0 0 0"/>

    <worldbody>

        <!-- 地面 -->
        <geom name="ground"
              type="plane"
              size="3 3 0.1"
              rgba="0.7 0.7 0.7 1"/>

        <!-- 固定底座 -->
        <body name="base" pos="0 0 0.2">

            <geom type="cylinder"
                  size="0.15 0.2"
                  rgba="0.3 0.3 0.3 1"/>

            <!-- 第一个关节：底座旋转 -->
            <body name="link1" pos="0 0 0.2">

                <joint name="joint1"
                       type="hinge"
                       axis="0 0 1"
                       range="-3.14 3.14"
                       damping="2"/>

                <geom type="sphere"
                      size="0.09"
                      rgba="0.2 0.2 0.2 1"/>

                <!-- 第二个关节：肩部 -->
                <body name="link2">

                    <joint name="joint2"
                           type="hinge"
                           axis="0 1 0"
                           range="-1.5 1.5"
                           damping="2"/>

                    <geom type="capsule"
                          fromto="0 0 0 0.55 0 0"
                          size="0.055"
                          rgba="0.1 0.4 0.9 1"/>

                    <!-- 第三个关节：肘部 -->
                    <body name="link3" pos="0.55 0 0">

                        <joint name="joint3"
                               type="hinge"
                               axis="0 1 0"
                               range="-1.5 1.5"
                               damping="2"/>

                        <geom type="capsule"
                              fromto="0 0 0 0.45 0 0"
                              size="0.045"
                              rgba="0.9 0.3 0.2 1"/>

                        <!-- 末端执行器位置 -->
                        <site name="end_effector"
                              pos="0.45 0 0"
                              size="0.065"
                              rgba="0 1 0 1"/>

                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- 关节位置控制器 -->
    <actuator>

        <position name="motor1"
                  joint="joint1"
                  kp="100"
                  kv="15"/>

        <position name="motor2"
                  joint="joint2"
                  kp="100"
                  kv="15"/>

        <position name="motor3"
                  joint="joint3"
                  kp="100"
                  kv="15"/>

    </actuator>

</mujoco>
