
<?xml version="1.0"?>

<robot name="MyRobotArm_URDF">

    <mujoco>
        <compiler discardvisual="false"/>
    </mujoco>

    <!-- 固定底座 -->
    <link name="base">
        <visual>
            <origin xyz="0 0 0.2"/>
            <geometry>
                <cylinder radius="0.15" length="0.4"/>
            </geometry>
            <material name="gray">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
        </visual>
    </link>

    <!-- 第一个旋转部分 -->
    <link name="link1">
        <visual>
            <geometry>
                <sphere radius="0.09"/>
            </geometry>
            <material name="dark">
                <color rgba="0.2 0.2 0.2 1"/>
            </material>
        </visual>
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0" ixz="0"
                     iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- 蓝色连杆 -->
    <link name="link2">
        <visual>
            <origin xyz="0.275 0 0" rpy="0 1.57079632679 0"/>
            <geometry>
                <cylinder radius="0.055" length="0.55"/>
            </geometry>
            <material name="blue">
                <color rgba="0.1 0.4 0.9 1"/>
            </material>
        </visual>
        <inertial>
            <origin xyz="0.275 0 0"/>
            <mass value="1"/>
            <inertia ixx="0.03" ixy="0" ixz="0"
                     iyy="0.03" iyz="0" izz="0.002"/>
        </inertial>
    </link>

    <!-- 红色连杆 -->
    <link name="link3">
        <visual>
            <origin xyz="0.225 0 0" rpy="0 1.57079632679 0"/>
            <geometry>
                <cylinder radius="0.045" length="0.45"/>
            </geometry>
            <material name="red">
                <color rgba="0.9 0.3 0.2 1"/>
            </material>
        </visual>
        <inertial>
            <origin xyz="0.225 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.01" ixy="0" ixz="0"
                     iyy="0.01" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <!-- 末端位置 -->
    <link name="end_effector"/>

    <!-- Joint 1: 绕 Z 轴旋转 -->
    <joint name="joint1" type="revolute">
        <parent link="base"/>
        <child link="link1"/>
        <origin xyz="0 0 0.4" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14"
               effort="100" velocity="5"/>
        <dynamics damping="2"/>
    </joint>

    <!-- Joint 2: 绕 Y 轴旋转 -->
    <joint name="joint2" type="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5" upper="1.5"
               effort="100" velocity="5"/>
        <dynamics damping="2"/>
    </joint>

    <!-- Joint 3: 绕 Y 轴旋转 -->
    <joint name="joint3" type="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0.55 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5" upper="1.5"
               effort="100" velocity="5"/>
        <dynamics damping="2"/>
    </joint>

    <!-- 固定末端执行器 -->
    <joint name="tool_fixed" type="fixed">
        <parent link="link3"/>
        <child link="end_effector"/>
        <origin xyz="0.45 0 0" rpy="0 0 0"/>
    </joint>

</robot>
